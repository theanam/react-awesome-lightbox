{
  "name": "react-awesome-lightbox",
  "version": "2.0.0",
  "description": "Lightweight, accessible lightbox image viewer for React with zoom, pan, rotate, pinch and keyboard support. Single or multi image mode.",
  "keywords": [
    "react",
    "lightbox",
    "image viewer",
    "image zoom",
    "image rotate",
    "image gallery",
    "pinch zoom",
    "react lightbox",
    "responsive lightbox",
    "typescript"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./style.css": "./dist/style.css",
    "./build/style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "demo": "vite demo",
    "demo:build": "vite build demo",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsup": "^9.0.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "author": {
    "name": "Anam Ahmed",
    "email": "anam.ahmed.a@gmail.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/theanam/react-awesome-lightbox.git"
  },
  "homepage": "https://theanam.github.io/react-awesome-lightbox/",
  "bugs": {
    "url": "https://github.com/theanam/react-awesome-lightbox/issues"
  }
}
