{
  "compilerOptions": {
    "target": "ES2020",
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "node",
      "vitest/globals",
      "@testing-library/jest-dom"
    ],
    "baseUrl": ".",
    "paths": {
      "react-awesome-lightbox": [
        "./src/index.ts"
      ],
      "react-awesome-lightbox/style.css": [
        "./src/style.css"
      ]
    }
  },
  "include": [
    "src",
    "test",
    "demo/src",
    "tsup.config.ts",
    "vitest.config.ts",
    "demo/vite.config.ts"
  ]
}
